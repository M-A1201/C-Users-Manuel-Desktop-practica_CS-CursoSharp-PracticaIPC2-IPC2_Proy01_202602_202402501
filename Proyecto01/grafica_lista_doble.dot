digraph ListaDoble {
    rankdir=LR;
    node [shape=record, style=filled, fillcolor=lightblue];

    nodo0 [label="<ant> | <data> Guatemala | <sig>"];
    nodo1 [label="<ant> | <data> Quetzaltenango | <sig>"];
    nodo2 [label="<ant> | <data> Escuintla | <sig>"];
    nodo3 [label="<ant> | <data> Sacatepequez | <sig>"];
    nodo0:sig -> nodo1:data;
    nodo1:ant -> nodo0:data;
    nodo1:sig -> nodo2:data;
    nodo2:ant -> nodo1:data;
    nodo2:sig -> nodo3:data;
    nodo3:ant -> nodo2:data;
}
